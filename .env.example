# ───────────────────────── Loomix — متغيرات البيئة ─────────────────────────
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تُرفع ملفات .env إلى المستودع.
# كل المفاتيح هنا تُقرأ على الخادم فقط. أي متغيّر يبدأ بـ NEXT_PUBLIC_ يصبح عامًّا.

# قاعدة البيانات
# محليًا: PGlite (Postgres مدمج يعمل داخل العملية) — لا يحتاج تثبيت خادم.
DATABASE_URL="pglite://.data/pglite"
# اختياري: مسار بديل لملفات PGlite (افتراضيًا .data/pglite)
# PGLITE_DIR=".data/pglite"
#
# في الإنتاج: Postgres مُدار يدعم الاتصال عبر Pooler (مثال Neon/Supabase).
# استخدم رابطًا واحدًا لكل بيئة، وفضّل Pooler لأن دوال Vercel قصيرة العمر.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/loomix?sslmode=require"

# عنوان الموقع العام — يُستخدم في canonical وOG وsitemap وروابط البريد.
# في الإنتاج: https://your-domain.com بدون / في النهاية.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# اسم كوكي الجلسة (httpOnly). غيّره إن أردت عزلًا بين بيئتين.
SESSION_COOKIE_NAME="loomix_session"

# سر تشغيلي (32 حرفًا عشوائيًا على الأقل). يُستخدم لأغراض تشغيلية عامة،
# وليس بديلًا عن أسرار الجلسات لأن رموز الجلسات تُولَّد عشوائيًا وتُخزَّن مُجزَّأة.
APP_SECRET="change-me-to-a-long-random-string"

# حساب المدير الأول — يُستخدم مرة واحدة عند `npm run db:seed`.
# ⚠️ غيّر كلمة المرور قبل أي نشر علني، أو استخدم `npm run admin:password`.
ADMIN_EMAIL="admin@loomix.tv"
ADMIN_PASSWORD="Loomix@2026"
ADMIN_NAME="مدير Loomix"

# ── عرض بيانات الحساب التجريبي في صفحة الدخول ──
# اتركه معطّلًا في أي بيئة حقيقية. القيمة "1" تُظهر بريد المدير وكلمة مروره
# (المأخوذين من ADMIN_EMAIL/ADMIN_PASSWORD) لأي زائر — للتجربة المحلية فقط.
# SHOW_DEMO_CREDENTIALS="1"

# ── حارس التعبئة التجريبية ──
# `npm run db:seed` يمسح كل الجداول، فيرفض العمل على قاعدة شبكية أو في الإنتاج
# إلا إذا وُضع SEED_DEMO=1 صراحةً. اتركه غير مضبوط في أي بيئة حقيقية.
# SEED_DEMO="1"

# ── اختياري: حسابات فحص e2e (بيئات الاختبار فقط) ──
# يقرأها `npm run e2e`؛ الافتراضي هو حسابات العرض التجريبي أدناه.
# E2E_ADMIN_EMAIL="admin@loomix.tv"
# E2E_ADMIN_PASSWORD="Loomix@2026"

# ── حدّ محاولات الدخول (اختياري) ──
# الافتراضي 10 محاولات لكل IP في 10 دقائق، و8 لكل حساب في 15 دقيقة.
# لا ترفعه في الإنتاج. في بيئة اختبار محلية فقط يمكن رفعه ليتكرر `npm run e2e`.
# RATE_LIMIT_LOGIN_MAX="100"

# ── تخزين الصور (الإنتاج) ──
# محليًا: public/uploads. على Vercel: اربط مخزن Blob بالمشروع فيُحقن التوكن تلقائيًا،
# ويتحوّل التخزين دون أي تغيير في الكود (انظر lib/storage.ts وdocs/DEPLOY-VERCEL.md §7).
# BLOB_READ_WRITE_TOKEN=""
#
# سقف حجم الصورة بالميجابايت (الافتراضي 6). على Vercel اضبطه 4 لأن سقف جسم الطلب 4.5MB.
# UPLOAD_MAX_MB="4"

# ── اختياري: مفاتيح مصادر خارجية ──
# تُقرأ على الخادم فقط. لا تُضِف أي مفتاح إلى NEXT_PUBLIC_*.
# TMDB_API_KEY=""
# تشغيل مزامنة المصادر الخارجية يحتاج مراجعة شروط الخدمة أولًا (انظر docs/DEPLOYMENT.md).
